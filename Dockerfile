# syntax=docker/dockerfile:1

# One image for every server; the command picks the role:
#   docker run l2go login -config /etc/l2go/server.json
#   docker run l2go game -id 1 -config /etc/l2go/server.json

FROM golang:1.27 AS build
WORKDIR /src

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

COPY cmd ./cmd
COPY internal ./internal
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/l2go ./cmd/l2go


FROM gcr.io/distroless/static-debian12:nonroot

COPY --from=build /out/l2go /usr/local/bin/l2go

# Runtime files live under /opt/l2go, the working directory, so relative
# paths in the config ("scripts", "data") point here.
#   scripts/    Lua scripts and their pages, copied as defaults. docker
#               compose mounts ./scripts over them read-only for live
#               reload.
#   data/       game data generated by cmd/datagen: players, items, NPCs,
#               spawns, teleporters, zones and map regions. The game server
#               fails to start without it.
#   data/html/  NPC dialog pages, read from <dataDir>/html. Not in git:
#               `make data` copies them from the Mobius checkout, and the
#               COPY below takes them along when the folder exists. Without
#               it the image still builds, but NPCs have no dialog pages.
COPY scripts /opt/l2go/scripts
COPY data /opt/l2go/data
WORKDIR /opt/l2go

# 2106: clients to login, 9413: game servers to login, 7777: clients to game.
EXPOSE 2106 9413 7777

ENTRYPOINT ["/usr/local/bin/l2go"]
CMD ["login", "-config", "/etc/l2go/server.json"]
